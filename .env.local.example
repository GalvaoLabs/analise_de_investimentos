# Copie este arquivo para .env.local e preencha com a configuração do seu
# projeto Firebase (Project Settings > General > Your apps > Web app).
#
# Esses valores são PÚBLICOS por design do Firebase (a segurança real vem
# das Regras do Realtime Database, não de esconder essas chaves) — ainda
# assim, não é necessário commitar o .env.local no Git.
#
# ATENÇÃO: a DATABASE_URL só aparece depois que você cria o Realtime
# Database no console. Ela tem o formato:
#   https://SEU-PROJETO-default-rtdb.firebaseio.com
# (ou ...-default-rtdb.SUA-REGIAO.firebasedatabase.app, dependendo da
# região escolhida). Sem ela, o app não consegue salvar a carteira.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
